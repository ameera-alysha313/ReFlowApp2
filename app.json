{
  "expo": {
    "name": "ReFlo",
    "slug": "ReFlowApp2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ReFloIcon.png",
    "scheme": "reflowapp2",
    "userInterfaceStyle": "light", 
    "ios": {
      "icon": "./assets/icons/ReFloIcon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F7",
        "foregroundImage": "./assets/icons/ReFloIconTransparent.png",
        "monochromeImage": "./assets/icons/ReFloMonochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ReFloApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F7",
          "image": "./assets/icons/ReFloIconTransparent.png",
          "imageWidth": 76
        }
      ],
       "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/ReFloIcon.png",
          "color": "#4A90D9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30f6e30f-0fc7-4549-b630-e78f73434369"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/30f6e30f-0fc7-4549-b630-e78f73434369"
    }
  }
}
